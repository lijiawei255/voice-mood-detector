# =============================================================================
# 语音情绪识别系统 (Voice Mood Detector) — .gitignore
# 适用于开源协作 — 保护隐私和用户数据，保留测试代码和开发文档
# =============================================================================

# ==================== Python ====================
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
*.spec
*.spec.bak
*.manifest
.pytest_cache/

# 虚拟环境
.venv/
venv/
env/
ENV/

# ==================== AI 模型缓存（巨大文件，通过 requirements 自动下载） ====================
portable_data/
models/
*.pt
*.pth
*.bin         # 排除大型模型权重文件
*.safetensors

# ==================== 用户数据（绝不上传，含隐私/密钥/录音） ====================
recordings/
history.json
history.json.bak
history.json.corrupted
model_config.json
*.wav
*.mp3
*.flac
*.ogg

# ==================== 运行时生成文件 ====================
*.log
temp/
cache/
logs/

# ==================== 文档输出（非代码类） ====================
*.pdf
*.xlsx
*.xls
*.docx
*.doc

# ==================== IDE / 编辑器 ====================
.trae/
.vscode/
.idea/
*.swp
*.swo
*~

# ==================== 操作系统 ====================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# ==================== 开发过程文件 ====================
# .corrupted — 损坏的历史文件
*.corrupted
# 临时备份
*.tmp
*.bak

# ==================== 注意 ====================
# 以下文件已被移除排除规则，现在纳入版本控制：
# - test_*.py        → 开源测试代码，供他人运行验证
# - debug_*.py       → 开发调试工具，可供参考
# - 升级建议文档      → 改为 docs/ 目录下的正式规范文档
# - docs/superpowers/ → 设计规范和计划文档纳入版本控制
